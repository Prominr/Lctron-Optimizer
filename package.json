{
  "name": "lctron-optimizer",
  "version": "1.7.33",
  "description": "Lctron - Advanced Windows Optimization Suite",
  "author": "Lctron",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run react-dev\" \"wait-on http://localhost:3000 && electron .\"",
    "react-dev": "react-scripts start",
    "build": "react-scripts build",
    "electron-build": "npm run build && electron-builder",
    "electron-publish": "npm run build && electron-builder --publish always",
    "start": "electron ."
  },
  "build": {
    "appId": "com.lctron.optimizer",
    "productName": "Lctron Optimizer",
    "copyright": "Copyright © 2025 Lctron. All rights reserved.",
    "icon": "public/icon.ico",
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "requireAdministrator",
      "icon": "public/icon.ico",
      "publisherName": "Lctron",
      "signingHashAlgorithms": ["sha256"],
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Lctron Optimizer Setup.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "Prominr",
      "repo": "Lctron-Optimizer",
      "releaseType": "release"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "public/icon.ico",
      "package.json",
      "!scripts/**/*",
      "!node_modules/sharp/**/*",
      "!node_modules/@img/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "directories": {
      "buildResources": "public",
      "output": "dist"
    }
  },
  "homepage": "./",
  "dependencies": {
    "electron-is-dev": "^2.0.0",
    "electron-updater": "^6.3.9",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.378.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "recharts": "^2.12.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "wait-on": "^7.2.0"
  },
  "browserslist": {
    "production": [
      "last 1 electron version"
    ],
    "development": [
      "last 1 electron version"
    ]
  }
}
